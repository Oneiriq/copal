    {
      "name": "search",
      "description": "Retrieval across the tenant's extracted text: engine-selected candidates                      rescored in process, fused across lexical and semantic rankings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "The question, in the caller's own words."
          },
          "mode": {
            "type": "string",
            "description": "lexical, semantic, or hybrid (the default). A deployment without                              an embedding service answers lexically and says so."
          },
          "limit": {
            "type": "integer",
            "description": "Documents to return, 1..=100."
          },
          "prefix": {
            "type": "string",
            "description": "Keep results whose file path starts with this."
          },
          "content_type": {
            "type": "string",
            "description": "Keep results whose file carries this content type."
          },
          "cursor": {
            "type": "string",
            "description": "Continue a ranking from the previous page's next_cursor;                              best-effort, since rankings shift as content changes."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "reads"
      }
    },
    {
      "name": "file_text",
      "description": "One file's extracted text, as the pipeline stored it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The file whose extracted text to read."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "reads"
      }
    }
