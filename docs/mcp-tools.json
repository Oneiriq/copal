{
  "tools": [
    {
      "name": "files_list",
      "description": "List files for the authenticated tenant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Rows per page, at most 100."
          },
          "cursor": {
            "type": "string",
            "description": "Resume from a previous page."
          },
          "state": {
            "type": "string",
            "description": "Filter by state."
          },
          "sort": {
            "type": "string",
            "description": "Sort column, one of: created_at. Suffix with :desc for newest first."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "reads"
      }
    },
    {
      "name": "file_get",
      "description": "Fetch one of files by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "reads"
      }
    },
    {
      "name": "file_create",
      "description": "Create the file record; bytes follow through the content upload or an upload grant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The file's path, unique among the tenant's live files."
          },
          "content_type": {
            "type": "string",
            "description": "Declared type; defaults to application/octet-stream."
          },
          "access": {
            "type": "string",
            "description": "public, private, tenant, or grant; defaults to private."
          },
          "metadata": {
            "type": "object",
            "description": "Caller metadata, stored verbatim."
          },
          "idempotency_key": {
            "type": "string",
            "description": "Replays return the original record instead of a duplicate."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "write"
        ],
        "rateClass": "mutations"
      }
    },
    {
      "name": "file_issue_url",
      "description": "Issue a signed URL for a servable file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ttl_secs": {
            "type": "integer",
            "description": "Seconds until the URL stops working (default 900, max one year)."
          },
          "max_uses": {
            "type": "integer",
            "description": "Cap on redemptions; one-time links use 1. Unset = unlimited within the TTL."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "mutations"
      }
    },
    {
      "name": "file_issue_upload_url",
      "description": "Issue a single-use write capability, so a browser can upload without holding a tenant key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ttl_secs": {
            "type": "integer",
            "description": "Seconds until the upload URL stops working (default 900, max one day)."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "write"
        ],
        "rateClass": "mutations"
      }
    },
    {
      "name": "file_issue_edge_url",
      "description": "Issue a cg2 token a CDN can verify itself, without a database hop.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ttl_secs": {
            "type": "integer",
            "description": "Seconds until the token expires (default 900, max one day). Edge tokens cannot be revoked individually."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "read"
        ],
        "rateClass": "mutations"
      }
    },
    {
      "name": "file_request_rendition",
      "description": "Derive an image rendition; repeating a request returns the existing one.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Rendition label, part of the derived path (default \"thumb\")."
          },
          "width": {
            "type": "integer",
            "description": "Bounding width, 16..=4096 (default 256)."
          },
          "height": {
            "type": "integer",
            "description": "Bounding height, 16..=4096 (default 256)."
          },
          "format": {
            "type": "string",
            "description": "\"jpeg\" (default) or \"png\"."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "write"
        ],
        "rateClass": "mutations"
      }
    },
    {
      "name": "file_remove",
      "description": "Soft-delete: tombstone the record and free its live path; bytes are reclaimed by garbage collection once nothing references them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "requiredScopes": [
          "write"
        ],
        "rateClass": "mutations"
      }
    },
